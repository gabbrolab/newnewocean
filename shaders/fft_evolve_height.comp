#version 430 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (rg32f, binding = 0) uniform readonly image2D uH0;
layout (rg32f, binding = 1) uniform writeonly image2D uSpectrum;

uniform int uResolution;
uniform float uPatchLength;
uniform float uTime;
uniform float uGravity;
uniform float uHeightScale;

const float PI = 3.14159265359;

vec2 complexMultiply(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

vec2 complexConjugate(vec2 value)
{
    return vec2(value.x, -value.y);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= uResolution || coord.y >= uResolution) {
        return;
    }

    int sx = coord.x < uResolution / 2 ? coord.x : coord.x - uResolution;
    int sy = coord.y < uResolution / 2 ? coord.y : coord.y - uResolution;
    ivec2 negCoord = ivec2((uResolution - coord.x) % uResolution, (uResolution - coord.y) % uResolution);

    float dk = 2.0 * PI / uPatchLength;
    vec2 k = vec2(float(sx), float(sy)) * dk;
    float kLength = length(k);

    if (kLength < 0.0001) {
        imageStore(uSpectrum, coord, vec4(0.0));
        return;
    }

    float omega = sqrt(uGravity * kLength);
    float phase = omega * uTime;
    vec2 positive = vec2(cos(phase), sin(phase));
    vec2 negative = vec2(cos(-phase), sin(-phase));
    vec2 h0 = imageLoad(uH0, coord).xy;
    vec2 h0Neg = complexConjugate(imageLoad(uH0, negCoord).xy);
    vec2 evolved = complexMultiply(h0, positive) + complexMultiply(h0Neg, negative);

    imageStore(uSpectrum, coord, vec4(evolved * uHeightScale, 0.0, 1.0));
}
