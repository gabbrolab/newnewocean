#version 430 core

// Packs h0(k) together with conj(h0(-k)) into a single RGBA texel so the time
// evolution pass can build a Hermitian spectrum. Ported from CS_PackSpectrumConjugate.

layout (local_size_x = 8, local_size_y = 8) in;

layout (rgba32f, binding = 0) uniform image2DArray uInitialSpectrum;

uniform int uN;

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= uN || id.y >= uN) {
        return;
    }

    for (int i = 0; i < 4; ++i) {
        vec2 h0 = imageLoad(uInitialSpectrum, ivec3(id, i)).rg;
        ivec2 mirror = ivec2((uN - id.x) % uN, (uN - id.y) % uN);
        vec2 h0conj = imageLoad(uInitialSpectrum, ivec3(mirror, i)).rg;

        imageStore(uInitialSpectrum, ivec3(id, i), vec4(h0, h0conj.x, -h0conj.y));
    }
}
