#version 430 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (rg32f, binding = 0) uniform readonly image2D uSource;
layout (rg32f, binding = 1) uniform writeonly image2D uDestination;

uniform int uResolution;
uniform int uHalfSize;
uniform int uHorizontal;
uniform int uInverse;

const float PI = 3.14159265359;

vec2 complexMultiply(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= uResolution / 2 || id.y >= uResolution) {
        return;
    }

    int blockSize = uHalfSize * 2;
    int group = id.x / uHalfSize;
    int pairIndex = id.x - group * uHalfSize;
    int i0 = group * blockSize + pairIndex;
    int i1 = i0 + uHalfSize;

    ivec2 coord0 = uHorizontal != 0 ? ivec2(i0, id.y) : ivec2(id.y, i0);
    ivec2 coord1 = uHorizontal != 0 ? ivec2(i1, id.y) : ivec2(id.y, i1);

    vec2 a = imageLoad(uSource, coord0).xy;
    vec2 b = imageLoad(uSource, coord1).xy;

    float sign = uInverse != 0 ? 1.0 : -1.0;
    float angle = sign * PI * float(pairIndex) / float(uHalfSize);
    vec2 twiddle = vec2(cos(angle), sin(angle));
    vec2 rotated = complexMultiply(b, twiddle);

    imageStore(uDestination, coord0, vec4(a + rotated, 0.0, 1.0));
    imageStore(uDestination, coord1, vec4(a - rotated, 0.0, 1.0));
}
