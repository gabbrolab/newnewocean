#version 430 core

// Shared-memory Stockham inverse FFT along the Y axis, run for all 8 spectrum
// layers. Identical to the horizontal pass except the texel access is
// transposed so each workgroup walks a column. Ported from CS_VerticalFFT.

#define SIZE 512
#define LOG_SIZE 9

layout (local_size_x = SIZE, local_size_y = 1, local_size_z = 1) in;

layout (rgba32f, binding = 0) uniform image2DArray uTarget;

vec2 complexMul(vec2 a, vec2 b)
{
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

shared vec4 fftGroupBuffer[2][SIZE];

void butterflyValues(uint step, uint index, out uvec2 indices, out vec2 twiddle)
{
    const float twoPi = 6.28318530718;
    uint b = uint(SIZE) >> (step + 1u);
    uint w = b * (index / b);
    uint i = (w + index) % uint(SIZE);

    float angle = -twoPi / float(SIZE) * float(w);
    twiddle = vec2(cos(angle), sin(angle));
    twiddle.y = -twiddle.y;

    indices = uvec2(i, i + b);
}

vec4 fft(uint threadIndex, vec4 input)
{
    fftGroupBuffer[0][threadIndex] = input;
    barrier();
    bool flag = false;

    for (uint step = 0u; step < uint(LOG_SIZE); ++step) {
        uvec2 inputIndices;
        vec2 twiddle;
        butterflyValues(step, threadIndex, inputIndices, twiddle);

        int src = flag ? 1 : 0;
        int dst = flag ? 0 : 1;
        vec4 v = fftGroupBuffer[src][inputIndices.y];
        fftGroupBuffer[dst][threadIndex] = fftGroupBuffer[src][inputIndices.x]
            + vec4(complexMul(twiddle, v.xy), complexMul(twiddle, v.zw));

        flag = !flag;
        barrier();
    }

    return fftGroupBuffer[flag ? 1 : 0][threadIndex];
}

void main()
{
    uint col = gl_GlobalInvocationID.x;
    int row = int(gl_GlobalInvocationID.y);

    for (int i = 0; i < 8; ++i) {
        ivec3 coord = ivec3(row, int(col), i);
        vec4 value = fft(col, imageLoad(uTarget, coord));
        imageStore(uTarget, coord, value);
    }
}
